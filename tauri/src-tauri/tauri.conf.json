{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BrushLLM Player",
  "version": "0.0.4",
  "identifier": "dev.brushllm.player",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "BrushLLM Player",
        "width": 900,
        "height": 500,
        "minWidth": 640,
        "minHeight": 340,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "languages": [
          "English",
          "SimpChinese",
          "TradChinese",
          "Japanese",
          "Korean",
          "German",
          "Spanish",
          "French",
          "PortugueseBR"
        ],
        "displayLanguageSelector": true
      }
    }
  }
}